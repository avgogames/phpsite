{
    "name": "avgogames/hardware-store",
    "description": "Bolt & Nut: a small online hardware store built on plain PHP and PostgreSQL",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": { "App\\": "src/" },
        "files": ["src/helpers.php"]
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "scripts": {
        "migrate": "php bin/migrate.php",
        "seed": "php bin/seed.php",
        "serve": "php -S localhost:8000 -t public public/index.php",
        "test": "phpunit"
    },
    "config": { "sort-packages": true }
}
