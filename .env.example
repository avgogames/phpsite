# Application
APP_ENV=development          # development | production
APP_DEBUG=true               # never true in production
APP_URL=http://localhost:8000
APP_NAME="Bolt & Nut Hardware"
CURRENCY_SYMBOL=$

# Shipping (cents)
SHIPPING_FLAT_CENTS=599
FREE_SHIPPING_THRESHOLD_CENTS=5000

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=hardware_store
DB_USER=store
DB_PASSWORD=store

# Initial admin account created by `php bin/seed.php`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
